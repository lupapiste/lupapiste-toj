  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-cljs-test": "^0.1.0",
    "karma-junit-reporter": "^2.0.1",
    "less": "^4.2.0",
    "puppeteer": "^23.7.0"
  }
}
